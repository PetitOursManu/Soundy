{
  "name": "soundy",
  "private": true,
  "version": "1.5.6",
  "description": "Soundy — lecteur de musique neumorphique pour Emby (web + Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "express": "^4.22.3",
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
